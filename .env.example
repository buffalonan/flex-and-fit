# Daily backups of the database (newest 30 kept in each folder), both on this Mac's disk. update.sh uploads them to
# Google Drive's Backups/Fitness (newest 30 kept): with rclone if it has a Google Drive remote, else through
# Google Drive for desktop's folder.
BACKUP_DIR=/Users/<you>/Documents/fitness-backups/weekly
DRIVE_BACKUP_DIR=/Users/<you>/Documents/fitness-backups/drive-pendiente
# Optional: where rclone uploads them (remote:folder). Empty: the first "drive" remote, folder Backups/Fitness.
RCLONE_DESTINO=
# Optional: a key the app must send to sync (Perfil → Clave). Leave empty to rely on Tailscale and the home Wi-Fi.
SYNC_TOKEN=
# Written by update.sh every hour: this Mac's addresses on the home Wi-Fi and Tailscale, for the app.
DIRECCIONES=
