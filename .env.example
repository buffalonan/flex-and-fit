# Weekly backups of the database, like Ghostfolio's (newest 12 kept in each folder).
BACKUP_DIR=/Users/<you>/Documents/fitness-backups/weekly
DRIVE_BACKUP_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Backups/Fitness
# Optional: a key the app must send to sync (Ajustes → Clave). Leave empty to rely on Tailscale and the home Wi-Fi.
SYNC_TOKEN=
