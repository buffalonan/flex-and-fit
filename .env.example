# Daily backups of the database (newest 30 kept in each folder). update.sh also copies them to Google Drive's
# My Drive/Backups/Fitness when Google Drive for desktop is installed.
BACKUP_DIR=/Users/<you>/Documents/fitness-backups/weekly
DRIVE_BACKUP_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Backups/Fitness
# Optional: a key the app must send to sync (Perfil → Clave). Leave empty to rely on Tailscale and the home Wi-Fi.
SYNC_TOKEN=
# Written by update.sh every hour: this Mac's addresses on the home Wi-Fi and Tailscale, for the app.
DIRECCIONES=
